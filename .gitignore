# 调研副本（上游文档/参考工程副本，不纳入版本库）
.research/

# DevEco / Hvigor 构建产物
build/
# 本项目自己的产物（核心包等）。**刻意与根 build/ 分开**：
# 根 build/ 属于 HarmonyOS 构建，`devecocli build` 会清掉它（实测踩过）
dist/
.hvigor/
.idea/
oh_modules/
*.har
*.hap
*.app
*.hqf
local.properties

# 日志与临时文件
*.log
.DS_Store
Thumbs.db
# 模拟器/真机验收截图（体积大、可随时重截）
screenshots/

# 内置的端侧核心包（约 63 MB，由 `node tools/pack-core.mjs --place-in-app` 产出）
# 不进版本库：进版本库的是"如何生产它"（tools/pack-core.mjs + hostcore/core-recipe.json）
entry/src/main/resources/resfile/*.zip

# Host 入口脚本的放位产物（由 `node tools/place-host-app.mjs` 从 hostcore/app/ 同步过来）。
# 同样：字节不进库、方法（放置脚本 + hostcore/app/ 的源码）进库。
entry/src/main/resources/resfile/resources/

# 阶段一的运行时载体（由 tools/electron-runtime/collect.ps1 从 dist/ 导入）
# libelectron.so 单个就有 172.7 MB，绝不能进版本库
runtime/
# 运行时原生库（libelectron.so 等，由 collect.ps1 + 手工复制进入 entry/libs）
entry/libs/

# 华为侧 release 产物（账号门禁、无公开 URL，由人放入根目录；见 tools/electron-runtime/README.md）
v*-release.zip

# hostkit（PC 侧搭桥服务）生成的状态与临时文件（身份私钥/设备白名单/审计/自签证书）
hostkit/node_modules/
hostkit/.hostkit/
hostkit/**/*.pem
hostkit/**/*.key
hostkit/**/*.crt
hostkit/**/*.jsonl
hostkit/**/*.tmp

# hvigor 为每个 HAR 模块生成的 BuildProfile.ets（HAR_VERSION / BUILD_MODE_NAME / DEBUG）。
# 【为什么必须忽略】它含 `BUILD_MODE_NAME = 'debug'|'release'`，即**随构建模式变化**的生成物；
# 提交它会在每次 build 后产生纯噪声 diff（实测只差换行符），release 构建还会把它改错。
# 构建时自动重新生成，不需要进版本库。
**/BuildProfile.ets

# CMake 构建原生模块所需的 Node 头文件（由 tools/node-runtime/sync-node-headers.sh 同步）。
# 几十 MB 的三方头文件：字节不进库、方法（同步脚本）进库。
entry/src/main/cpp/node-headers/

# koffi 3.x 源码与生成物（由 `node tools/fetch-koffi.mjs` 取到 third_party/koffi/）。
# 【为什么要自建】dsh 要 `koffi ^3.1.0`，鸿蒙只有 2.16.2 移植版；详见 D6 E47/E50。
third_party/
