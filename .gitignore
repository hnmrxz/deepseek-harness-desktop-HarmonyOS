# 调研副本（上游文档/参考工程副本，不纳入版本库）
.research/

# DevEco / Hvigor 构建产物
build/
# 本项目自己的产物（核心包等）。**刻意与根 build/ 分开**：
# 根 build/ 属于 HarmonyOS 构建，`devecocli build` 会清掉它（实测踩过）
dist/
.hvigor/
.idea/
oh_modules/
*.har
*.hap
*.app
*.hqf
local.properties

# 日志与临时文件
*.log
.DS_Store
Thumbs.db
# 模拟器/真机验收截图（体积大、可随时重截）
screenshots/

# 内置的端侧核心包（约 63 MB，由 `node tools/pack-core.mjs --place-in-app` 产出）
# 不进版本库：进版本库的是"如何生产它"（tools/pack-core.mjs + hostcore/core-recipe.json）
entry/src/main/resources/resfile/*.zip

# hostkit（PC 侧搭桥服务）生成的状态与临时文件（身份私钥/设备白名单/审计/自签证书）
hostkit/node_modules/
hostkit/.hostkit/
hostkit/**/*.pem
hostkit/**/*.key
hostkit/**/*.crt
hostkit/**/*.jsonl
hostkit/**/*.tmp
