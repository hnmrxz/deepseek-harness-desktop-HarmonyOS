{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    },
    // 走 DevEco 的标准 CMake 路径构建原生模块（见 src/main/cpp/CMakeLists.txt 的说明）：
    // 目的是让 **hvigor 自己** 编译/链接出 .so 并生成原生模块映射，
    // 而不是我们手工把预编译 .so 丢进 entry/libs/（那条路实测绑不上，D6 E25–E29）。
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      // 目标 ABI：
      //   arm64-v8a = 真机（上架目标，Mate 70 等）
      //   x86_64    = 本机鸿蒙模拟器（开发机为 AMD64，镜像只能是 x86_64）
      // 两者都要编，否则模拟器装不上（HAP 里没有它需要的 so）。
      // 注意：**核心运行时的原生件**（libnode.so.127 / koffi / node-pty）不在这里编，
      // 它们是预编译件，按 ABI 放在 entry/libs/<abi>/ 下（见 tools/node-runtime/）。
      "abiFilters": ["arm64-v8a", "x86_64"]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}